# Django Configuration
SECRET_KEY=django-insecure-adventureworks-reporting-system-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AdventureWorks SQL Server (Docker or Local Instance)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=AdventureWorks2019
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!

# ODBC Driver:
# macOS default: ODBC Driver 18 for SQL Server
# Windows default: ODBC Driver 18 for SQL Server (or ODBC Driver 17 for SQL Server)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes
