# Django Configuration
SECRET_KEY=django-insecure-adventureworks-reporting-system-dev-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AdventureWorks SQL Server (Windows Local / SSMS)
# Server name examples from SSMS:
#   Default instance:   localhost (or .)
#   SQL Server Express: localhost\SQLEXPRESS (or .\SQLEXPRESS)
DB_HOST=localhost
# Leave DB_PORT empty for local Windows instances or named instances (SQLEXPRESS).
# Set DB_PORT=1433 for explicit TCP/IP, or 1434 for a Docker container.
DB_PORT=
DB_NAME=AdventureWorks2019

# Authentication:
#   Windows Authentication (SSMS default): set DB_TRUSTED_CONNECTION=yes and leave DB_USER/DB_PASSWORD blank.
#   SQL Server Authentication: set DB_TRUSTED_CONNECTION=no and fill in DB_USER and DB_PASSWORD.
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# ODBC Driver:
# Windows default: ODBC Driver 18 for SQL Server (or ODBC Driver 17 for SQL Server)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes
